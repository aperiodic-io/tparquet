+                Compression::SNAPPY,
+                1,
+                Some(vec![version.clone(), kv1.clone()]),
+                vec![stale.clone()]
+            ),
+            Some(vec![kv1])
+        );
+        // (an empty list stays a list, as upstream writes one given by the caller)
+        assert_eq!(
+            pcodec_kv_metadata(pcodec, 0, Some(vec![version]), vec![stale]),
+            Some(vec![])
+        );
+    }
