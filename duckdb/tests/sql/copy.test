# name: tests/sql/copy.test
# description: COPY ... (FORMAT tparquet) and back
require tparquet

statement ok
CREATE TABLE trades AS SELECT i AS id, (TIMESTAMP '2025-01-01' + INTERVAL (i) SECOND)::TIMESTAMP_MS AS ts, (100 + (i % 50) * 0.01)::DOUBLE AS price, 'S' || (i % 3) AS sym FROM range(10000) r(i)

statement ok
COPY trades TO '__TEST_DIR__/trades.parquet' (FORMAT tparquet, COLUMN_NAMES ['id', 'ts', 'price', 'sym'], POLICY 'auto', LEVEL 8)

query IIR
SELECT count(*), sum(id), sum(price)::DECIMAL(12,2) FROM read_tparquet('__TEST_DIR__/trades.parquet')
----
10000	49995000	1002450.00

query I
SELECT count(*) FROM (SELECT * FROM trades EXCEPT ALL SELECT * FROM read_tparquet('__TEST_DIR__/trades.parquet'))
----
0

statement ok
CREATE TABLE again AS SELECT * FROM trades LIMIT 0

statement ok
COPY again FROM '__TEST_DIR__/trades.parquet' (FORMAT tparquet)

query I
SELECT count(*) FROM again
----
10000

# the C API v1 gives a COPY function the types of the columns, not their names
onlyif v1
statement error
COPY trades TO '__TEST_DIR__/x.parquet' (FORMAT tparquet)
----
needs COLUMN_NAMES

# the C API v2 gives both
onlyif v2
statement ok
COPY trades TO '__TEST_DIR__/named.parquet' (FORMAT tparquet)

onlyif v2
query I
SELECT count(*) FROM (SELECT * FROM trades EXCEPT ALL SELECT * FROM read_tparquet('__TEST_DIR__/named.parquet'))
----
0

onlyif v2
query T
SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM read_tparquet('__TEST_DIR__/named.parquet'))
----
id,ts,price,sym

statement error
COPY trades TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c', 'd'], POLICY 'quick')
----
unknown policy "quick": expected auto, pcodec or base

statement error
SELECT * FROM read_tparquet('__TEST_DIR__/missing.parquet')
----
read_tparquet: no such file
