@@ -217,6 +217,22 @@ public:
 	duckdb_parquet::CompressionCodec::type GetCodec() {
 		return options.codec;
 	}
+	//! tparquet: the codec of one column. PCODEC compresses INT32, INT64, FLOAT and DOUBLE columns; the other
+	//! columns of a PCODEC file get ZSTD
+	duckdb_parquet::CompressionCodec::type GetCodec(idx_t schema_idx) {
+		if (options.codec != duckdb_parquet::CompressionCodec::PCODEC) {
+			return options.codec;
+		}
+		switch (GetType(schema_idx)) {
+		case duckdb_parquet::Type::INT32:
+		case duckdb_parquet::Type::INT64:
+		case duckdb_parquet::Type::FLOAT:
+		case duckdb_parquet::Type::DOUBLE:
+			return duckdb_parquet::CompressionCodec::PCODEC;
+		default:
+			return duckdb_parquet::CompressionCodec::ZSTD;
+		}
+	}
 	duckdb_parquet::Type::type GetType(idx_t schema_idx) {
 		return file_meta_data.schema[schema_idx].type;
 	}
