"""Stubs of the extension module (python/src)."""

from typing import Any, final

__version__: str

class PcodecError(ValueError):
    """A Parquet file, a PCODEC payload or an argument is not valid."""

@final
class RecordBatchStream:
    """A one-shot stream of record batches."""

    def __arrow_c_stream__(self, requested_schema: object | None = None) -> object: ...
    def __arrow_c_schema__(self) -> object: ...
    def __iter__(self) -> RecordBatchStream: ...
    def __next__(self) -> Batch: ...

@final
class Batch:
    """One record batch."""

    def __arrow_c_array__(self, requested_schema: object | None = None) -> tuple[object, object]: ...
    @property
    def num_rows(self) -> int: ...

@final
class ArrowSchema:
    """An Arrow schema."""

    def __arrow_c_schema__(self) -> object: ...
    @property
    def names(self) -> list[str]: ...

@final
class File:
    """A Parquet file whose footer has been read."""

    def schema(self) -> ArrowSchema: ...
    def stream(
        self,
        columns: list[str] | None = None,
        row_groups: list[int] | None = None,
        batch_size: int = 65536,
        limit: int | None = None,
    ) -> RecordBatchStream: ...
    def empty(self, columns: list[str] | None = None) -> RecordBatchStream: ...
    def metadata(self) -> dict[str, Any]: ...
    def inspect(self) -> str: ...
    def integer_bounds(self) -> list[dict[str, tuple[int, int]]]: ...
    def column_bounds(self) -> tuple[dict[str, str], list[dict[str, tuple[int, int]]]]: ...

@final
class Writer:
    """Writes record batches to one Parquet file."""

    def __init__(self, sink: object, schema: object, options: dict[str, Any]) -> None: ...
    def write_stream(self, stream: object) -> None: ...
    def write_batch(self, schema: object, array: object) -> None: ...
    def flush(self) -> None: ...
    def close(self) -> dict[str, str]: ...
    def abort(self) -> None: ...
    @property
    def codecs(self) -> dict[str, str] | None: ...
    @property
    def closed(self) -> bool: ...

def open_path(path: str) -> File: ...
def open_bytes(data: bytes) -> File: ...
def verify(a: File, b: File) -> str | None: ...
def transcode(input: File, sink: object, target: str, options: dict[str, Any]) -> dict[str, str]: ...
def write_stream(sink: object, stream: object, options: dict[str, Any]) -> dict[str, str]: ...

CODEC_ID: int
FORMAT_VERSION: int
KV_KEY: str

def compress(data: bytes, hint: str | None = None, level: int = 8) -> bytes: ...
def decompress(payload: bytes, expected_len: int) -> bytes: ...
def mode(payload: bytes) -> str: ...

# for the tests: panics in Rust become PcodecError
def _panic(message: str | None = None) -> None: ...

@final
class PanickingStream:
    def stream(self) -> RecordBatchStream: ...
