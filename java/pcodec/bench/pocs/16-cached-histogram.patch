+  /**
+   * Histograms already computed while compressing one chunk, by the latents they were computed
+   * from: the candidates of one chunk can bin the very same latents (a chunk of at most 200 numbers
+   * is its own delta sample, so the chosen delta's sample candidate is the final one), and the
+   * histogram is the costliest part of training. The bins are a function of the latents in their
+   * order, so an entry only serves an equal array of the same type and bin count.
+   */
+  static final class HistogramCache {
+    private static final class Entry {
+      final Latent lt;
+      final int nBinsLog;
+      final long[] latents;
+      final List<Histogram.Bin> bins;
+
+      Entry(Latent lt, int nBinsLog, long[] latents, List<Histogram.Bin> bins) {
+        this.lt = lt;
+        this.nBinsLog = nBinsLog;
+        this.latents = latents;
+        this.bins = bins;
+      }
+    }
+
+    private final List<Entry> entries = new ArrayList<>();
+
+    /** {@link Histogram#histogram}, which reorders {@code latents} unless it is a hit */
+    List<Histogram.Bin> histogram(long[] latents, Latent lt, int nBinsLog) {
+      for (Entry e : entries) {
+        if (e.lt == lt && e.nBinsLog == nBinsLog && Arrays.equals(e.latents, latents)) {
+          return e.bins;
+        }
+      }
+      // the key is taken before the histogram reorders the latents
+      long[] key = latents.clone();
+      List<Histogram.Bin> bins = Histogram.histogram(latents, lt, nBinsLog);
+      entries.add(new Entry(lt, nBinsLog, key, bins));
+      return bins;
+    }
+  }
+
   /** {@code train_infos}; {@code latents} is scratch (it gets reordered). */
   static Trained trainInfos(Latent lt, long[] latents, int unoptimizedBinsLog) {
+    return trainInfos(lt, latents, unoptimizedBinsLog, new HistogramCache());
+  }
+
+  /** {@link #trainInfos} with the histogram taken from {@code cache} when it has it */
+  static Trained trainInfos(
+      Latent lt, long[] latents, int unoptimizedBinsLog, HistogramCache cache) {
     if (latents.length == 0) {
       return new Trained(new ArrayList<>(), 0, new int[0]);
     }
     int nLatents = latents.length;
-    List<Histogram.Bin> unoptimized = Histogram.histogram(latents, lt, unoptimizedBinsLog);
+    List<Histogram.Bin> unoptimized = cache.histogram(latents, lt, unoptimizedBinsLog);
     int nLogCeil = nLatents <= 1 ? 0 : (31 - Integer.numberOfLeadingZeros(nLatents - 1)) + 1;
     int estimatedAnsSizeLog = Math.min(Math.min(unoptimizedBinsLog + 2, 12), nLogCeil);
     List<BinInfo> optimized = optimizeBins(lt, unoptimized, estimatedAnsSizeLog);
