+++ b/java/pcodec/src/main/java/io/aperiodic/pcodec/BitWriter.java
@@ -53,6 +53,17 @@ final class BitWriter {
     return Arrays.copyOf(buf, (int) ((bitIdx + 7) >>> 3));
   }
 
+  /**
+   * Grows the buffer to hold {@code moreBytes} more bytes at once, to the exact size rather than
+   * by doubling, so a writer told what is coming copies its buffer (at most) once.
+   */
+  void reserve(long moreBytes) {
+    long need = (bitIdx >>> 3) + moreBytes + 9;
+    if (need > buf.length) {
+      buf = Arrays.copyOf(buf, (int) Math.min(need, MAX_CAPACITY));
+    }
+  }
+
   /** the largest buffer a Java array holds */
   static final int MAX_CAPACITY = Integer.MAX_VALUE - 8;
 
