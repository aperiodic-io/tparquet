+  /**
+   * {@code log2Approx} of every count in [0, totalCount], when there are no more of them than
+   * (j, i) pairs to cost; null otherwise.
+   */
+  private static float[] log2Table(int totalCount, int nb) {
+    if ((long) totalCount >= (long) nb * (nb + 1) / 2) {
+      return null;
+    }
+    float[] table = new float[totalCount + 1];
+    for (int k = 0; k <= totalCount; k++) {
+      table[k] = log2Approx(RustMath.u64ToF32(k));
+    }
+    return table;
+  }
