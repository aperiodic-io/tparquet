<?xml version="1.0" encoding="UTF-8"?>
<!-- pcodec-java: a pure Java implementation of pcodec 1.0.4 (standalone format), byte for byte
     the output of the Rust reference, and the PCODEC page payload of spec/FORMAT.md.
     No dependencies at run time; see README.md and VERIFICATION.md. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.aperiodic.tparquet</groupId>
  <artifactId>pcodec-java</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>pcodec-java</name>
  <description>Pure Java pcodec (pco 1.0.4 standalone format) and the PCODEC Parquet page payload</description>
  <url>https://github.com/aperiodic-io/tparquet</url>

  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- parquet-java 1.17 targets Java 11, so the library does too; tests use 17 -->
    <maven.compiler.release>11</maven.compiler.release>
    <maven.compiler.testRelease>17</maven.compiler.testRelease>
    <!-- the repository root: testdata/ -->
    <tparquet.root>${project.basedir}/../..</tparquet.root>
    <!-- the Rust reference oracle (oracle/), built by `make -C java/pcodec oracle`; parity tests
         that need it are skipped when it is absent, unless pcodec.oracle.required is true -->
    <pcodec.oracle>${project.basedir}/oracle/target/release/pcodec-oracle</pcodec.oracle>
    <pcodec.oracle.required>false</pcodec.oracle.required>
    <!-- scale of the randomized parity suites (cases per property) -->
    <pcodec.parity.scale>1</pcodec.parity.scale>
    <junit.version>5.14.4</junit.version>
    <zstd.test.version>2.0.2</zstd.test.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- a pure Java Zstandard decoder for the ZSTD-mode conformance vectors (test only; the
         library takes a ZSTD decoder as a plug-in, ZstdCodec) -->
    <dependency>
      <groupId>io.airlift</groupId>
      <artifactId>aircompressor</artifactId>
      <version>${zstd.test.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <argLine>-Xss8m -Xmx3g</argLine>
          <systemPropertyVariables>
            <tparquet.testdata>${tparquet.root}/testdata</tparquet.testdata>
            <pcodec.vectors>${project.basedir}/vectors</pcodec.vectors>
            <pcodec.oracle>${pcodec.oracle}</pcodec.oracle>
            <pcodec.oracle.required>${pcodec.oracle.required}</pcodec.oracle.required>
            <pcodec.parity.scale>${pcodec.parity.scale}</pcodec.parity.scale>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.aperiodic.pcodec</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
